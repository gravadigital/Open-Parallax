# Configuración local de OpenParallax. No hace falta para arrancar: cada valor de este
# archivo ya es el default de docker-compose.yml y de los Makefiles. Para cambiar algo,
# copia este archivo a .env (no se versiona) y edita solo lo que necesites.
#
# Todo lo de acá es para desarrollo local: los secretos por defecto son públicos.

# --- Puertos en esta máquina ---------------------------------------------------
API_PORT=8080
WEB_PORT=3000
POSTGRES_PORT=5432
STORAGE_PORT=3900
MAILPIT_PORT=8025
PGADMIN_PORT=5050

# --- Base de datos (PostgreSQL) --------------------------------------------------
POSTGRES_DB=openparallax_db
POSTGRES_USER=openparallax
POSTGRES_PASSWORD=openparallax_password

# --- Almacenamiento de propuestas (Garage, S3) -----------------------------------
# Cambiar la clave con el volumen ya creado impide arrancar Garage: `make reset` lo resuelve.
S3_BUCKET=openparallax
S3_ACCESS_KEY_ID=GKopenparallaxlocal01
S3_SECRET_ACCESS_KEY=openparallax-local-secret-0123456789
STORAGE_RPC_SECRET=4b1d2f8e0c7a9b3e5d6f1a2c4e8b0d7f9a1c3e5b7d9f0a2c4e6b8d0f2a4c6e8b
STORAGE_ADMIN_TOKEN=openparallax-local-admin-token

# --- api -----------------------------------------------------------------------
# Firma de las sesiones (JWT). Obligatoria: la api no arranca sin ella.
JWT_SECRET=openparallax-local-dev-secret-no-usar-en-produccion
# release | debug. Con debug la api registra el SQL completo.
GIN_MODE=release
# Tamaño máximo de una propuesta, en bytes (10 MB).
MAX_FILE_SIZE=10485760
CORS_ALLOW_ORIGINS=*

# --- Login con Google (opcional) ----------------------------------------------------
# Vacío: solo login con email y contraseña. Para activarlo, crea un "OAuth client ID"
# de tipo "Web application" en https://console.cloud.google.com/apis/credentials, con
# http://localhost:3000 como "Authorized JavaScript origin", y copia su Client ID acá.
# Lo usan la api (para verificar el token) y la web (para el botón).
GOOGLE_CLIENT_ID=

# --- Email ---------------------------------------------------------------------
# Por defecto los mails van a Mailpit (http://localhost:8025) y nada sale de la máquina.
# Para usar un servidor real, cambia SMTP_* y EMAIL_FROM. La api siempre usa STARTTLS
# (o TLS directo con SMTP_SECURE=true) y autenticación.
EMAIL_ENABLED=true
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=openparallax
SMTP_PASSWORD=local
SMTP_SECURE=false
EMAIL_FROM=no-reply@openparallax.local
EMAIL_FROM_NAME=OpenParallax

# --- pgAdmin (opcional: docker compose --profile tools up -d pgadmin) ---------------
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin

# --- Variables de los servicios fuera de Compose ------------------------------------
# docker-compose.yml y `make dev` las fijan a partir de las de arriba. Se listan para
# correr un servicio de otra forma; sus defaults son los del código.
#
# api (services/api/internal/config/config.go):
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=openparallax
# DB_PASSWORD=openparallax_password
# DB_NAME=openparallax_db
# DB_SSLMODE=disable
# PORT=8080
# FRONTEND_URL=http://localhost:3000        # base de los enlaces de los mails
# STORAGE_PROVIDER=local                    # local | s3
# STORAGE_LOCAL_PATH=./uploads
# UPLOADS_DIR=./uploads                     # solo se registra en el log
# S3_ENDPOINT=http://localhost:3900
# S3_PRESIGN_ENDPOINT=                      # hoy sin efecto
# S3_REGION=garage
# CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,HEAD,OPTIONS
# CORS_ALLOW_HEADERS=Origin,Content-Length,Content-Type,Authorization
# GOOGLE_TOKENINFO_URL=https://oauth2.googleapis.com/tokeninfo     # solo los tests e2e lo cambian
# GOOGLE_USERINFO_URL=https://www.googleapis.com/oauth2/v3/userinfo
# SSL_CERT_DIR=                             # CA extra (Compose: el certificado de Mailpit)
# TEST_DB_NAME=openparallax_test            # base de los tests de integración
#
# web, contenedor (services/web/docker/40-runtime-config.sh), leídas al arrancar:
# API_URL=http://localhost:8080             # como la ve el navegador
# GOOGLE_CLIENT_ID=
#
# web, `npm start` (`make dev`), leídas al compilar:
# REACT_APP_API_URL=http://localhost:8080
# REACT_APP_GOOGLE_CLIENT_ID=
